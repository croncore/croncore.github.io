# Images are referenced by stable filenames, so `immutable` would pin stale
# bytes at the edge for a year after any edit — replacing an image in place
# would simply never reach visitors. Preferred practice is still to version
# the filename when swapping an asset (e.g. 1.webp -> 1.v2.webp); this TTL is
# the safety net for when that step is missed.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ---------- Security headers (all responses) ----------
# No CSP yet: the site has ~90 inline scripts plus GTM, so an enforced policy
# needs a nonce/hash pass first. These four are safe on a static site.
/*
  Strict-Transport-Security: max-age=15552000
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# ---------- Keep non-production hosts out of search ----------
# The Pages default domain and branch previews are full copies of the site.
# www.croncore.com is not matched by these rules, so production stays indexable.
https://croncore.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:branch.croncore.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://staging.croncore.com/*
  X-Robots-Tag: noindex, nofollow
